# Site settings for scripts/hpc (copy to scripts/hpc/site.env, which git ignores, and fill in). Sourced by bash.
# Every CHANGE_ME must be replaced: submit.sh refuses to run while one is left. On UCI HPC3 check the values with
#   sinfo -o "%P %G %l" (partitions, GPU types, time limits)   and   sbalance / sacctmgr show assoc user=$USER (accounts)
HPC_PARTITION=CHANGE_ME          # e.g. a paid GPU partition (gpu) or a free / preemptible one (free-gpu)
HPC_ACCOUNT=CHANGE_ME            # the lab's GPU account (often <pi>_lab_gpu); "" = the user's default account
HPC_GPU_TYPE=CHANGE_ME           # --gres=gpu:<type>:<n>, e.g. A100 / A30 / V100 / L40S ("" = any GPU)
HPC_CPUS_PER_GPU=8               # data loading + SQLite execution workers
HPC_MEM_PER_GPU_GB=64            # host RAM per GPU: every training process loads the whole plan set (~20 GB)
HPC_TIME=24:00:00                # per-job wall time (the queue's limit; training resumes across jobs)
HPC_MODULES=""                   # modules to load first, e.g. "cuda/12.4" (empty = none)
HPC_TORCH_BACKEND=cu126          # uv --torch-backend for setup.sh: must match the nodes' driver (nvidia-smi on a GPU node)
HPC_VENV=$HOME/luthor-venv       # created by setup.sh
LUTHOR_DATA=CHANGE_ME            # data root on the cluster (scratch / pub space): sys1/, dev_databases/, dev.json
HF_HOME=CHANGE_ME                # Hugging Face cache (big disk; compute nodes read it offline)
MAX_RESUBMITS=12                 # training jobs re-queue themselves until the run finishes, at most this many times
